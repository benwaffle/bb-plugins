{
  "name": "bb-plugin-leader-keys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doom Emacs style leader keys: tap Space (or Option+Space anywhere) and type a short sequence, with a which-key popup and a cheat sheet.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/leader-keys#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/leader-keys"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "keyboard",
    "leader",
    "which-key"
  ],
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.68"
  },
  "bb": {
    "name": "Leader keys",
    "description": "Doom Emacs style leader keys: tap Space (or Option+Space anywhere) and type a short sequence, with a which-key popup and a cheat sheet.",
    "branding": {
      "icon": "Keyboard"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "README.md",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "host.ts",
    "keymap.ts",
    "machine.ts",
    "shortcuts.ts",
    "actions.ts"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.68",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.46.2-nightly.39799382507.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
