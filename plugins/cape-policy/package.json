{
  "name": "bb-plugin-cape-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enforces Cape security settings in bb: bb account, bb cloud AI, and bb connect off, telemetry off.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/cape-policy#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/cape-policy"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "policy",
    "security",
    "cape"
  ],
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Cape policy",
    "description": "Enforces Cape security settings in bb: bb account, bb cloud AI, and bb connect off, telemetry off.",
    "branding": {
      "icon": "ShieldCheck"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "README.md",
    "policy.json",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "policy.ts"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
