{
  "name": "bb-plugin-claude-title",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Write thread titles and commit messages with your Claude Code login; no bb cloud account needed.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/claude-title#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/claude-title"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "claude",
    "claude-code",
    "thread-title",
    "commit-message"
  ],
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Claude Code titles",
    "description": "Write thread titles and commit messages with your Claude Code login; no bb cloud account needed.",
    "branding": {
      "icon": "Sparkles"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "contract.ts",
    "server.ts",
    "host.ts"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "env -u BB_CLI bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "bb-app": "0.44.0",
    "cron-parser": "^5.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
