{
  "name": "bb-plugin-voice-whisper-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transcribe voice input locally with whisper.cpp; no cloud account needed.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/voice-whisper-local#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/voice-whisper-local"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "whisper",
    "speech-to-text",
    "voice",
    "transcription"
  ],
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
    "name": "Local voice (whisper.cpp)",
    "description": "Transcribe voice input locally with whisper.cpp; no cloud account needed.",
    "branding": {
      "icon": "Mic"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "skills/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "contract.ts",
    "server.ts",
    "host.ts"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "env -u BB_CLI bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@types/node": "^22.0.0",
    "bb-app": "0.43.1",
    "cron-parser": "^5.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
