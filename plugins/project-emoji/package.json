{
  "name": "bb-plugin-project-emoji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An emoji beside every project in the sidebar, picked automatically or chosen by hand.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/project-emoji#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/project-emoji"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "sidebar",
    "projects",
    "emoji"
  ],
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Project emoji",
    "description": "An emoji beside every project in the sidebar, picked automatically or chosen by hand.",
    "branding": {
      "icon": "Smile"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "README.md",
    "skills",
    "server.ts",
    "app.tsx",
    "channel.ts",
    "contract.ts",
    "decorate.ts",
    "emoji.ts",
    "store.ts",
    "components",
    "lib"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.3"
  }
}
