{
  "name": "bb-plugin-nav-shortcuts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mod+[ and Mod+] go back and forward through bb's page history.",
  "license": "MIT",
  "author": "Ben Iofel",
  "homepage": "https://github.com/benwaffle/bb-plugins/tree/main/plugins/nav-shortcuts#readme",
  "bugs": {
    "url": "https://github.com/benwaffle/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwaffle/bb-plugins.git",
    "directory": "plugins/nav-shortcuts"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "keyboard",
    "shortcuts",
    "navigation"
  ],
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Back and forward shortcuts",
    "description": "Mod+[ and Mod+] go back and forward through bb's page history.",
    "branding": {
      "icon": "ChevronLeft"
    },
    "server": "./server.ts",
    "app": "./app.ts"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "README.md",
    "server.ts",
    "app.ts"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "bb-app": "0.44.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
